# Example environment variables for Landing Page API

# PostgreSQL connection string for Prisma
# format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/landingpage"

# Port for the Express server (defaults to 3000 if not set)
PORT=3000

# Add any other environment variables your application uses below
# e.g. JWT_SECRET, API_KEYS, etc.