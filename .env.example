# Example environment variables for InventoryAPI

# Port for the Express server
PORT=3000

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:3000"

# JWT secret for auth token signing
JWT_SECRET="your_jwt_secret_here"

# Stripe keys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Supabase / PostgreSQL connection (via connection pooling)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Optional: backup/local database URL
DATABASE_URL_BACKUP="postgresql://user:password@localhost:5432/inventory?schema=public"
